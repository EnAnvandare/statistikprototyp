# Kopiera till .env och fyll i. .env checkas aldrig in.
# Valfritt OpenAI-kompatibelt API.

# Alternativ 1: Berget (svenskt, data stannar i Sverige)
LLM_BASE_URL=https://api.berget.ai/v1
LLM_API_KEY=
# Förslag: moonshotai/Kimi-K3 (bäst på verktygsanrop) eller google/gemma-4-31B-it (billigare, bra svenska)
LLM_MODEL=moonshotai/Kimi-K3
# Berget: en låg temperatur ger stabilare svar
LLM_TEMPERATURE=0.2

# Alternativ 2: Claude via Claude API (nyckel från console.anthropic.com, faktureras separat
# från en Claude Code-prenumeration). Ta bort LLM_TEMPERATURE – Claude avvisar värden under 1.
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

PORT=5173
